# ADVERTICO — Apache sozlamalari
Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Public sahifalar: URL .html bo'lib qoladi, kontent PHP orqali bazadan olinadi.
    RewriteRule ^$ render.php?page=index [L,QSA]
    RewriteRule ^(index|about|services|portfolio|locations|contact)\.html$ render.php?page=$1 [L,QSA]
    RewriteRule ^sitemap\.xml$ render.php?page=sitemap [L]
    RewriteRule ^robots\.txt$ render.php?page=robots [L]

    # Maxfiy papkalar va fayllarni yopish.
    RewriteRule ^(app|database)(/|$) - [F,L]
    RewriteRule (^|/)\.(?!well-known) - [F,L]
    RewriteRule \.(sql|md|txt|log|bak|ini|lock|example)$ - [F,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
